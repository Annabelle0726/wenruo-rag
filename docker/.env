# -----------------------------------------------------------------------------
# SECURITY WARNING: DO NOT DEPLOY WITH DEFAULT PASSWORDS
# For non-local deployments, please change all passwords (ELASTIC_PASSWORD,
# MYSQL_PASSWORD, MINIO_PASSWORD, etc.) to strong, unique values.
# You can generate a random string using: openssl rand -hex 32
# -----------------------------------------------------------------------------

# Compose project name. Containers and volumes of this stack are named
# <project>-* (e.g. wenruo-rag-mysql-1).
COMPOSE_PROJECT_NAME=wenruo-rag

# ------------------------------
# Development mode
# ------------------------------
# RAGFLOW_DEV_MODE=false

# ------------------------------
# docker env var for specifying vector db type at startup
# ------------------------------
DOC_ENGINE=${DOC_ENGINE:-elasticsearch}
DB_TYPE=${DB_TYPE:-mysql}
DEVICE=${DEVICE:-cpu}
METADATA_DB_PROFILE=${METADATA_DB_PROFILE:-mysql}
COMPOSE_PROFILES=${DOC_ENGINE},${DEVICE},metadata-${METADATA_DB_PROFILE}

# The version of Elasticsearch.
STACK_VERSION=${STACK_VERSION:-8.11.3}
ES_HOST=es01
ES_PORT=1200
ELASTIC_PASSWORD=infini_rag_flow

OS_PORT=1201
OS_HOST=opensearch01
OPENSEARCH_PASSWORD=infini_rag_flow_OS_01

KIBANA_PORT=6601
MEM_LIMIT=8073741824

INFINITY_HOST=infinity
INFINITY_THRIFT_PORT=23817
INFINITY_HTTP_PORT=23820
INFINITY_PSQL_PORT=5432

SERENEDB_HOST=serenedb
SERENEDB_PORT=7890
SERENEDB_PASSWORD=infini_rag_flow

OCEANBASE_HOST=oceanbase
OCEANBASE_PORT=2881
OCEANBASE_USER=root@ragflow
OCEANBASE_PASSWORD=infini_rag_flow
OCEANBASE_DOC_DBNAME=ragflow_doc

GAUSSDB_HOST=
GAUSSDB_PORT=
GAUSSDB_DATABASE=postgres
GAUSSDB_USER=
GAUSSDB_PASSWORD=
GAUSSDB_SCHEMA=

OB_CLUSTER_NAME=${OB_CLUSTER_NAME:-ragflow}
OB_TENANT_NAME=${OB_TENANT_NAME:-ragflow}
OB_SYS_PASSWORD=${OCEANBASE_PASSWORD:-infini_rag_flow}
OB_TENANT_PASSWORD=${OCEANBASE_PASSWORD:-infini_rag_flow}
OB_MEMORY_LIMIT=${OB_MEMORY_LIMIT:-10G}
OB_SYSTEM_MEMORY=${OB_SYSTEM_MEMORY:-2G}
OB_DATAFILE_SIZE=${OB_DATAFILE_SIZE:-20G}
OB_LOG_DISK_SIZE=${OB_LOG_DISK_SIZE:-20G}

SEEKDB_HOST=seekdb
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=infini_rag_flow
SEEKDB_DOC_DBNAME=ragflow_doc
SEEKDB_MEMORY_LIMIT=2G

MYSQL_PASSWORD=infini_rag_flow
MYSQL_HOST=mysql
MYSQL_DBNAME=rag_flow
MYSQL_PORT=3306
EXPOSE_MYSQL_PORT=3307
MYSQL_MAX_PACKET=1073741824

GAUSSDB_METADATA_HOST=
GAUSSDB_METADATA_PORT=
GAUSSDB_METADATA_USER=
GAUSSDB_METADATA_PASSWORD=
GAUSSDB_METADATA_DBNAME=rag_flow
GAUSSDB_METADATA_SCHEMA=public
GAUSSDB_METADATA_MAX_CONNECTIONS=100
GAUSSDB_METADATA_STALE_TIMEOUT=30

MINIO_HOST=minio
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=infini_rag_flow

NATS_HOST=nats
NATS_PORT=4222
EXPOSE_NATS_PORT=4222

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_TCP_PORT=9000
EXPOSE_CLICKHOUSE_TCP_PORT=9900
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=ragflow
CLICKHOUSE_PASSWORD=infini_rag_flow
CLICKHOUSE_DATABASE=ragflow

JAEGER_VERSION=2.19.0
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686

SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
GO_HTTP_PORT=9384
GO_ADMIN_PORT=9383

# ADMIN_DEFAULT_PASSWORD is deliberately unset: it is read only when no
# superuser exists, and leaving it at a known value would recreate the
# documented default on a fresh database. The bootstrap password is generated
# and written to logs/admin_bootstrap_password.txt (mode 0600) instead.
API_PROXY_SCHEME=python
ALLOW_ANY_HOST=0

RAGFLOW_IMAGE=my-wenruorag:release-20261002-retrieval-phase2

TEI_IMAGE_CPU=infiniflow/text-embeddings-inference:cpu-1.8
TEI_IMAGE_GPU=infiniflow/text-embeddings-inference:1.8
TEI_MODEL=${TEI_MODEL:-Qwen/Qwen3-Embedding-0.6B}
TEI_HOST=tei
TEI_PORT=6380

TZ=Asia/Shanghai

DOC_BULK_SIZE=${DOC_BULK_SIZE:-4}
EMBEDDING_BATCH_SIZE=${EMBEDDING_BATCH_SIZE:-16}
RERANK_TOKEN_LIMIT_MODE=${RERANK_TOKEN_LIMIT_MODE:-truncate}

REGISTER_ENABLED=0
ENABLE_REGISTER=0

USE_DOCLING=false
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
THREAD_POOL_MAX_WORKERS=128

WIKI_MAP_LLM_POOL_SIZE=20
WIKI_MAP_MAX_PENDING=25
WIKI_REFINE_WORKERS=4
WIKI_MAP_WORKERS=20
WIKI_MAP_TIMEOUT=600
WIKI_REDUCE_TIMEOUT=60
WIKI_PLAN_TIMEOUT=600
WIKI_REFINE_TIMEOUT=300
WIKI_MERGE_TIMEOUT=600

DOC_STRUCTURE_COMPILE_BATCH_CHUNKS=4
DOC_STRUCTURE_COMPILE_MAX_IN_FLIGHT=15
DOC_STRUCTURE_LLM_POOL_SIZE=20
STRUCTURE_CONTEXT_FRACTION=0.5
STRUCTURE_DEFAULT_CONTEXT=100000
KNOWLEDGE_GRAPH_CONTEXT_FRACTION=0.1
KNOWLEDGE_GRAPH_MAX_BATCH_TOKENS=4096
STRUCTURE_CHAIN_CORRECTION_TIMEOUT_S=120

LLM_POOL_RATE_LIMIT_RETRIES=3
LLM_POOL_RATE_LIMIT_RETRY_BASE_DELAY=1.0
LLM_POOL_RATE_LIMIT_RETRY_MAX_DELAY=30.0

DISABLE_PASSWORD_LOGIN=false
SHOW_CABLE_ONLY=false