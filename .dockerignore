# RAGFlow .dockerignore
# Reduces Docker build context sent to the daemon.
# All excluded items are either rebuilt inside Docker, mounted from
# infiniflow/wenruo_deps, or are local-only artifacts.

# ── Python virtual environments ─────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# ── Frontend dependencies and build outputs ─────────────────────────────────
# web/dist/ is deliberately NOT ignored: with WEB_DIST_MODE=prebuilt the
# Dockerfile ships a locally built dist from the build context instead of
# running the vite build inside the container.
web/node_modules/

# ── Runtime logs ────────────────────────────────────────────────────────────
logs/
*.log
docker/ragflow-logs/

# ── Docker runtime data ─────────────────────────────────────────────────────
docker/data/
docker/oceanbase/
docker/seekdb/

# ── Go and C++ build outputs ────────────────────────────────────────────────
internal/binding/cpp/build/
internal/binding/cpp/cmake-build-release/
internal/binding/cpp/cmake-build-debug/
target/

# ── wenruo_deps build context (built as a separate image, mounted ──
# ── from infiniflow/wenruo_deps:latest by the main Dockerfile)     ──
# Excluding the directory contents keeps the main build context small
# regardless of which deps files download_deps.py currently fetches.
# The deps image is built from this directory with:
#   cd wenruo_deps && docker build -f Dockerfile -t infiniflow/wenruo_deps .
# The two ORT version-pin files are re-included: build.sh's
# check_ort_version_consistency (run by Dockerfile_go's `--go` build) greps
# them. Re-including requires NOT excluding the directory itself.
wenruo_deps/*
!wenruo_deps/download_go_deps.py
!wenruo_deps/download_deps.py

# ── IDE and editor config ──────────────────────────────────────────────────
.idea/
.vscode/
.cursor/
.trae/
.DS_Store

# ── Test and coverage artifacts ─────────────────────────────────────────────
coverage/
htmlcov/
.coverage
.hypothesis/
.nox/

# ── Docker env (contains secrets) ───────────────────────────────────────────
docker/.env

# Local runtime credentials and diagnostic captures are not build inputs.
conf/service_conf.yaml
deploy/repair_gates/
.freebuff/
.git

delivery-private/

delivery/private/

conf/private.pem
conf/public.pem
